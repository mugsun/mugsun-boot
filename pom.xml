<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.13</version>
		<relativePath/>
	</parent>

	<groupId>com.mugsun</groupId>
	<artifactId>mugsun-boot</artifactId>
	<version>0.1.0</version>
	<packaging>pom</packaging>
	<name>mugsun-boot</name>
	<description>Mugsun 单体版父工程（core + 可选 gis/track/ai + 装配壳）</description>
	<url>https://github.com/mugsun/mugsun-boot</url>

	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/license/mit</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<modules>
		<module>mugsun-boot-core</module>
		<module>mugsun-boot-gis</module>
		<module>mugsun-boot-track</module>
		<module>mugsun-boot-ai</module>
		<module>mugsun-boot-server</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<mugsun.version>0.1.0</mugsun.version>
		<kingbase.jdbc.version>9.0.1.jre7</kingbase.jdbc.version>
		<dameng.jdbc.version>8.1.3.62</dameng.jdbc.version>
		<jts.version>1.20.0</jts.version>
		<geographiclib.version>2.1</geographiclib.version>
		<bucket4j.version>8.21.0</bucket4j.version>
		<!-- 与已导入的 spring-cloud-circuitbreaker BOM 中的 resilience4j 一致 -->
		<resilience4j.version>2.2.0</resilience4j.version>
		<!-- B2：官方 MCP Java SDK，仅 server + Streamable HTTP；精确锁版本，enforcer 按 GAV 放行同一版本 -->
		<mcp-sdk.version>2.1.0</mcp-sdk.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.mugsun</groupId>
				<artifactId>mugsun-bom</artifactId>
				<version>${mugsun.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>com.mugsun</groupId>
				<artifactId>mugsun-boot-core</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.mugsun</groupId>
				<artifactId>mugsun-boot-core</artifactId>
				<version>${project.version}</version>
				<type>test-jar</type>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>com.mugsun</groupId>
				<artifactId>mugsun-boot-gis</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.mugsun</groupId>
				<artifactId>mugsun-boot-track</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.mugsun</groupId>
				<artifactId>mugsun-boot-ai</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.locationtech.jts</groupId>
				<artifactId>jts-core</artifactId>
				<version>${jts.version}</version>
			</dependency>
			<!-- 测地线正反解（Karney 算法，与 PostGIS 2.2+ geography 同源），MIT -->
			<dependency>
				<groupId>com.bucket4j</groupId>
				<artifactId>bucket4j_jdk17-core</artifactId>
				<version>${bucket4j.version}</version>
			</dependency>
			<dependency>
				<groupId>com.bucket4j</groupId>
				<artifactId>bucket4j_jdk17-lettuce</artifactId>
				<version>${bucket4j.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.resilience4j</groupId>
				<artifactId>resilience4j-core</artifactId>
				<version>${resilience4j.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.resilience4j</groupId>
				<artifactId>resilience4j-bulkhead</artifactId>
				<version>${resilience4j.version}</version>
			</dependency>
			<dependency>
				<groupId>net.sf.geographiclib</groupId>
				<artifactId>GeographicLib-Java</artifactId>
				<version>${geographiclib.version}</version>
			</dependency>
			<dependency>
				<groupId>com.icegreen</groupId>
				<artifactId>greenmail</artifactId>
				<version>2.1.11</version>
			</dependency>
			<!-- B2 MCP Server（MIT）。只放行 mcp-core 与 mcp-json-jackson2；不引 mcp 聚合包（会带 jackson3）、Spring AI starter -->
			<dependency>
				<groupId>io.modelcontextprotocol.sdk</groupId>
				<artifactId>mcp-core</artifactId>
				<version>${mcp-sdk.version}</version>
			</dependency>
			<dependency>
				<groupId>io.modelcontextprotocol.sdk</groupId>
				<artifactId>mcp-json-jackson2</artifactId>
				<version>${mcp-sdk.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<!-- 仅 mugsun-boot-server 可启动；其余模块跳过 spring-boot:run / repackage -->
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
			<!--
				B89-0：内置 MCP Server 暂时下线（加鉴权后恢复），Spring AI 随之移出依赖。Spring AI 的 MCP Server 自动装配不走本项目的鉴权，
				只要 jar 回到 classpath、配置一开就是匿名可调的端点；这里在 validate 阶段禁止它们（含传递依赖）重新进来。
				触发验证见 scripts/check-banned-dependencies.sh（CI 每次都跑）。
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>b89-banned-dependencies</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<bannedDependencies>
									<!-- B89-2：显式按传递依赖检查（默认值也是 true，写明防止被改掉）；探针见 scripts/check-banned-dependencies.sh 的 transitive-via-wrapper -->
									<searchTransitive>true</searchTransitive>
									<excludes>
										<exclude>org.springframework.ai</exclude>
										<exclude>io.modelcontextprotocol*</exclude>
									</excludes>
									<!-- B2：仅按 GAV 精确放行这两个构件的 2.1.0（[x] 为精确版本）；其他版本、其他 io.modelcontextprotocol 构件、Spring AI 仍拦下 -->
									<includes>
										<include>io.modelcontextprotocol.sdk:mcp-core:[2.1.0]</include>
										<include>io.modelcontextprotocol.sdk:mcp-json-jackson2:[2.1.0]</include>
									</includes>
									<message>B89-0：禁止引入 Spring AI（org.springframework.ai:*）与 MCP SDK（io.modelcontextprotocol*）。内置 MCP Server 暂时下线、正在加鉴权后恢复；仅放行 io.modelcontextprotocol.sdk:mcp-core / mcp-json-jackson2 的 2.1.0（B2，已过安全评审）；升级须同时改 includes 并重新评审。</message>
								</bannedDependencies>
							</rules>
							<fail>true</fail>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
