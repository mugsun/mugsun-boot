<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.13</version>
		<relativePath/>
	</parent>

	<groupId>com.mugsun</groupId>
	<artifactId>mugsun-boot</artifactId>
	<version>0.1.0</version>
	<packaging>pom</packaging>
	<name>mugsun-boot</name>
	<description>Mugsun 单体版父工程（core + 可选 gis/track + 装配壳）</description>

	<modules>
		<module>mugsun-boot-core</module>
		<module>mugsun-boot-gis</module>
		<module>mugsun-boot-track</module>
		<module>mugsun-boot-server</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<mugsun.version>0.1.0</mugsun.version>
		<kingbase.jdbc.version>9.0.1.jre7</kingbase.jdbc.version>
		<dameng.jdbc.version>8.1.3.62</dameng.jdbc.version>
		<jts.version>1.20.0</jts.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.mugsun</groupId>
				<artifactId>mugsun-bom</artifactId>
				<version>${mugsun.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>com.mugsun</groupId>
				<artifactId>mugsun-boot-core</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.mugsun</groupId>
				<artifactId>mugsun-boot-core</artifactId>
				<version>${project.version}</version>
				<type>test-jar</type>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>com.mugsun</groupId>
				<artifactId>mugsun-boot-gis</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.mugsun</groupId>
				<artifactId>mugsun-boot-track</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.locationtech.jts</groupId>
				<artifactId>jts-core</artifactId>
				<version>${jts.version}</version>
			</dependency>
			<dependency>
				<groupId>com.icegreen</groupId>
				<artifactId>greenmail</artifactId>
				<version>2.1.11</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
