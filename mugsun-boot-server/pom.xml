<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.mugsun</groupId>
		<artifactId>mugsun-boot</artifactId>
		<version>0.2.0-SNAPSHOT</version>
	</parent>

	<properties>
		<!-- DemoAccountsApiTest 默认走 Testcontainers，见 demo-accounts-it -->
		<demo.it.use.services>false</demo.it.use.services>
	</properties>
	<artifactId>mugsun-boot-server</artifactId>
	<name>mugsun-boot-server</name>
	<description>Mugsun 装配壳：默认全量（core+gis+track+ai）；-Pbasic 仅核心；-Pgis-only / -Ptrack-only / -Pai-only 单模块</description>
	<dependencies>
		<dependency>
			<groupId>com.mugsun</groupId>
			<artifactId>mugsun-boot-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.mugsun</groupId>
			<artifactId>mugsun-boot-core</artifactId>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<!-- AbstractIntegrationTest 用的 TestRestTemplate（test-jar 不传递测试依赖，这里要再声明一遍） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-resttestclient</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-restclient</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.icegreen</groupId>
			<artifactId>greenmail</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<build>
		<finalName>mugsun-boot</finalName>
		<plugins>
			<!-- DemoAccountsApiTest 需要 demo profile 的独立 Spring 上下文；warm-flow 静态 SpringUtil 不允许同 JVM 多上下文，故单独 fork -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<executions>
					<execution>
						<id>default-test</id>
						<configuration>
							<excludes>
								<exclude>**/DemoAccountsApiTest.java</exclude>
								<exclude>**/AiDisabledApiTest.java</exclude>
							</excludes>
							<!-- B89-0 守卫：模拟运维打开了暂时下线（加鉴权后恢复）的 MCP Server 开关，AiEnabledApiTest / AiDisabledApiTest 断言 /sse、/mcp 仍是 404 -->
							<environmentVariables>
								<MUGSUN_AI_MCP_SERVER>true</MUGSUN_AI_MCP_SERVER>
								<SPRING_AI_MCP_SERVER_ENABLED>true</SPRING_AI_MCP_SERVER_ENABLED>
							</environmentVariables>
						</configuration>
					</execution>
					<!-- B1：mugsun.ai.enabled=false 的独立上下文（属性不同；warm-flow 不允许同 JVM 多上下文） -->
					<execution>
						<id>ai-disabled-it</id>
						<goals>
							<goal>test</goal>
						</goals>
						<configuration>
							<includes>
								<include>**/AiDisabledApiTest.java</include>
							</includes>
							<!-- B89-0 守卫：模拟运维打开了暂时下线（加鉴权后恢复）的 MCP Server 开关，AiEnabledApiTest / AiDisabledApiTest 断言 /sse、/mcp 仍是 404 -->
							<environmentVariables>
								<MUGSUN_AI_MCP_SERVER>true</MUGSUN_AI_MCP_SERVER>
								<SPRING_AI_MCP_SERVER_ENABLED>true</SPRING_AI_MCP_SERVER_ENABLED>
							</environmentVariables>
						</configuration>
					</execution>
					<execution>
						<id>demo-accounts-it</id>
						<goals>
							<goal>test</goal>
						</goals>
						<configuration>
							<includes>
								<include>**/DemoAccountsApiTest.java</include>
							</includes>
							<!-- 日志链用例要隔离的库：CI 的外部服务库里留着别的运行（别的 SM2 密钥）签的旧日志，这里固定走 Testcontainers；
							     -Ddemo.it.use.services=true 可改回外部服务（用于复现） -->
							<environmentVariables>
								<MUGSUN_TEST_USE_SERVICES>${demo.it.use.services}</MUGSUN_TEST_USE_SERVICES>
							</environmentVariables>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- 这个模块自己没有业务代码，只把各模块装进可执行包。jar 插件默认「自己的内容没变就不重打」，
			     于是只改了别的模块、或只换了 Profile 时，可执行包还是上一次的旧包。这里要求每次都重打 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<forceCreation>true</forceCreation>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<mainClass>com.mugsun.boot.MugsunApplication</mainClass>
					<skip>false</skip>
					<!-- 与 java -jar 一致：以仓库根目录为工作目录，读取 ./config/application-local.yml -->
					<workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
					<!-- 本地 spring-boot:run 默认 dev：启动守卫只对 dev/test/local 放行（见 DeployProfiles） -->
					<profiles>
						<profile>dev</profile>
					</profiles>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<!-- 默认 full。单模块或 basic 必须关掉 full：mvn -Pgis-only,'!full' package -->
	<!-- 这个模块的测试是按全量装配写的（会用到 gis/track/ai 的类），只在 full 下编译和运行；
	     其余四种装配只管打包，用 maven.test.skip 跳过本模块的测试（其他模块自己的测试不受影响） -->
	<profiles>
		<profile>
			<id>full</id>
			<!-- 不用 activeByDefault：那样只要命令行点了本文件里任何别的 Profile（比如只想加驱动的 -Pkingbase），
			     full 就自动失效，包里只剩 core。这里写成「没定义 mugsun.assembly.custom 就生效」，
			     等于一直生效，只有命令行写 '!full' 才关掉 -->
			<activation>
				<property>
					<name>!mugsun.assembly.custom</name>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>com.mugsun</groupId>
					<artifactId>mugsun-boot-gis</artifactId>
				</dependency>
				<dependency>
					<groupId>com.mugsun</groupId>
					<artifactId>mugsun-boot-track</artifactId>
				</dependency>
				<dependency>
					<groupId>com.mugsun</groupId>
					<artifactId>mugsun-boot-ai</artifactId>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>basic</id>
			<!-- 激活时请同时关掉 full：mvn -Pbasic,'!full' package -->
			<properties>
				<maven.test.skip>true</maven.test.skip>
			</properties>
		</profile>
		<profile>
			<id>gis-only</id>
			<dependencies>
				<dependency>
					<groupId>com.mugsun</groupId>
					<artifactId>mugsun-boot-gis</artifactId>
				</dependency>
			</dependencies>
			<properties>
				<maven.test.skip>true</maven.test.skip>
			</properties>
		</profile>
		<profile>
			<id>track-only</id>
			<dependencies>
				<dependency>
					<groupId>com.mugsun</groupId>
					<artifactId>mugsun-boot-track</artifactId>
				</dependency>
			</dependencies>
			<properties>
				<maven.test.skip>true</maven.test.skip>
			</properties>
		</profile>
		<profile>
			<id>ai-only</id>
			<dependencies>
				<dependency>
					<groupId>com.mugsun</groupId>
					<artifactId>mugsun-boot-ai</artifactId>
				</dependency>
			</dependencies>
			<properties>
				<maven.test.skip>true</maven.test.skip>
			</properties>
		</profile>
		<profile>
			<id>kingbase</id>
			<dependencies>
				<dependency>
					<groupId>cn.com.kingbase</groupId>
					<artifactId>kingbase8</artifactId>
					<version>${kingbase.jdbc.version}</version>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>dameng</id>
			<dependencies>
				<dependency>
					<groupId>com.dameng</groupId>
					<artifactId>DmJdbcDriver18</artifactId>
					<version>${dameng.jdbc.version}</version>
					<scope>runtime</scope>
				</dependency>
				<!-- 社区 Flyway 不认 DM DBMS。mengweijin/db-migration 4.1.2 覆盖 Flyway 10.10–12.4，
				     它自己按 12.4.0 编译，和 Boot 4.1 带的 Flyway 是同一个版本。 -->
				<dependency>
					<groupId>com.github.mengweijin</groupId>
					<artifactId>db-migration-dameng-flyway</artifactId>
					<version>4.1.2</version>
				</dependency>
			</dependencies>
		</profile>
	</profiles>
</project>
