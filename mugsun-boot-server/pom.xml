<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.mugsun</groupId>
		<artifactId>mugsun-boot</artifactId>
		<version>0.1.0</version>
	</parent>
	<artifactId>mugsun-boot-server</artifactId>
	<name>mugsun-boot-server</name>
	<description>Mugsun 装配壳：默认全量（core+gis+track）；-Pbasic 仅核心</description>
	<dependencies>
		<dependency>
			<groupId>com.mugsun</groupId>
			<artifactId>mugsun-boot-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.mugsun</groupId>
			<artifactId>mugsun-boot-core</artifactId>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.icegreen</groupId>
			<artifactId>greenmail</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<build>
		<finalName>mugsun-boot</finalName>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<mainClass>com.mugsun.boot.MugsunApplication</mainClass>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<!-- 默认 full：带 gis+track；mvn -Pbasic package 仅核心 -->
	<profiles>
		<profile>
			<id>full</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<dependencies>
				<dependency>
					<groupId>com.mugsun</groupId>
					<artifactId>mugsun-boot-gis</artifactId>
				</dependency>
				<dependency>
					<groupId>com.mugsun</groupId>
					<artifactId>mugsun-boot-track</artifactId>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>basic</id>
			<!-- 激活时请同时关掉 full：mvn -Pbasic,'!full' package -->
		</profile>
		<profile>
			<id>kingbase</id>
			<dependencies>
				<dependency>
					<groupId>cn.com.kingbase</groupId>
					<artifactId>kingbase8</artifactId>
					<version>${kingbase.jdbc.version}</version>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>dameng</id>
			<dependencies>
				<dependency>
					<groupId>com.dameng</groupId>
					<artifactId>DmJdbcDriver18</artifactId>
					<version>${dameng.jdbc.version}</version>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>
	</profiles>
</project>
