# 本地联调覆盖：复制为同目录 application-local.yml（gitignore，不提交）。
# 启动时 Spring 会 optional import ./config/application-local.yml，无需再写 additional-location。
# 工作目录须为 mugsun-boot（mvn spring-boot:run 或 java -jar target/*.jar）。
mugsun:
  captcha:
    show-code: true   # 双因子登录验证码回显（本地联调）
  sms:
    show-code: true   # 短信验证码回显（本地联调）
  web:
    # e2e 走 :3007 时改为 http://localhost:3007，或导出 MUGSUN_FRONT_URL
    front-url: http://localhost:3006
  crypto:
    # 留空：dev profile 用 ~/.mugsun/dev-sm4.key（首次启动生成）；要固定就填 16 个字符（openssl rand -base64 12）
    sm4-key:
    # 留空：dev profile 用进程内临时密钥；要和前端互通就填 openssl rand -hex 16 的结果
    api-key:
    # 下列占位须换成你自己的密钥对；留空则每次启动临时生成（登录会 flake）
    sm2-private-key:
    sm2-public-key:
    sign-private-key:
    sign-public-key:
  social:
    enabled: true
    mock-enabled: true
    mock-authorize-url: http://localhost:8080/auth/social/mock-authorize
    type:
      mock:
        client-id: mock-client
        client-secret: mock-secret
        redirect-uri: "http://localhost:3006/#/auth/social-callback?source=mock"
