<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.mugsun</groupId>
		<artifactId>mugsun-boot</artifactId>
		<version>0.2.0-SNAPSHOT</version>
	</parent>
	<artifactId>mugsun-boot-ai</artifactId>
	<name>mugsun-boot-ai</name>
	<description>Mugsun AI 可选模块</description>
	<dependencies>
		<dependency>
			<groupId>com.mugsun</groupId>
			<artifactId>mugsun-boot-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.tika</groupId>
			<artifactId>tika-core</artifactId>
			<version>3.2.2</version>
		</dependency>
		<!-- PDF/DOCX/PPTX 正文抽取；OCR 不在 standard-package；排除 tess4j 防误拉 -->
		<dependency>
			<groupId>org.apache.tika</groupId>
			<artifactId>tika-parsers-standard-package</artifactId>
			<version>3.2.2</version>
			<exclusions>
				<exclusion>
					<groupId>org.apache.tika</groupId>
					<artifactId>tika-parser-ocr-module</artifactId>
				</exclusion>
				<exclusion>
					<groupId>net.sourceforge.tess4j</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- 只用 WebClient 调外部接口（不起响应式服务端）。Spring Boot 4 起 WebClient.Builder 的自动装配在这个启动包里，
		     spring-boot-starter-webflux 不再提供 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webclient</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- 只在测试时用：翻译文件的检查（AbstractI18nBundleTest）写在 mugsun-boot-core 的测试代码里，gis、track 也是这样引的 -->
		<dependency>
			<groupId>com.mugsun</groupId>
			<artifactId>mugsun-boot-core</artifactId>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
